# Database configuration
# Uses local SQLite by default if PostgreSQL is not running; uncomment the line below for PostgreSQL + pgvector:
# DATABASE_URL=postgresql+psycopg://chasqui:chasqui_secret@localhost:5432/chasqui
DATABASE_URL=sqlite:///./chasqui.db

# Embedding / AI Provider (local | gemini | openai)
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Daily Scheduled Scan Configuration
DAILY_SCRAPE_ENABLED=true
DAILY_SCRAPE_HOUR=06
DAILY_SCRAPE_MINUTE=00
MAX_ARTICLES_PER_SOURCE=15

# Backend API URL for the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
