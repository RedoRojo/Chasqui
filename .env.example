# Base de datos
# Por defecto usa SQLite local si PostgreSQL no está levantado; para usar PostgreSQL + pgvector descomenta la siguiente línea:
# DATABASE_URL=postgresql+psycopg://chasqui:chasqui_secret@localhost:5432/chasqui
DATABASE_URL=sqlite:///./chasqui.db

# Proveedor de Embeddings / IA (local | gemini | openai)
EMBEDDING_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=

# Configuración del Escaneo Diario
DAILY_SCRAPE_ENABLED=true
DAILY_SCRAPE_HOUR=06
DAILY_SCRAPE_MINUTE=00
MAX_ARTICLES_PER_SOURCE=15

# URL de la API para el frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
